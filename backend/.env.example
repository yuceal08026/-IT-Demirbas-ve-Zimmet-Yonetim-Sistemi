# Docker kullanmadan yerelde çalıştırmak için:  cp .env.example .env
NODE_ENV=development
PORT=3000

# Veritabanını Docker ile başlatmak için: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
DATABASE_URL=postgres://zimmet:zimmet-local-dev@localhost:5432/zimmet

# Boşsa her açılışta rastgele üretilir. Kalıcı olsun istiyorsanız en az 32 karakter girin.
JWT_SECRET=
JWT_EXPIRES_IN=8h
APP_BASE_URL=http://localhost:5173

SEED_ADMIN_EMAIL=admin@kurum.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_NAME=Sistem Yöneticisi
SEED_DEMO_DATA=true
