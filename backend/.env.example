# Docker kullanmadan yerelde çalıştırmak için:  cp .env.example .env
NODE_ENV=development
PORT=3000

# Veritabanını Docker ile başlatmak için (kök dizinde, .env dolu olmalı):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
# <PAROLA> yerine kök .env dosyasındaki POSTGRES_PASSWORD değerini yazın.
DATABASE_URL=postgres://zimmet:<PAROLA>@localhost:5432/zimmet

# Geliştirmede boş bırakılabilir (her açılışta geçici anahtar üretilir). Üretimde zorunlu, en az 32 karakter.
JWT_SECRET=
JWT_EXPIRES_IN=8h
APP_BASE_URL=http://localhost:5173
APP_TIMEZONE=Europe/Istanbul
# Kendi kendine kayda izin verilen e-posta alan adları (virgülle). Boşsa kayıt kapalıdır. Örnek: gop.edu.tr
REGISTRATION_EMAIL_DOMAINS=

# İsteğe bağlı ilk yönetici (önerilen: npm run create-admin -- --email ... --name "...")
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
