# Bu dosyayı ".env" adıyla kopyalayın ve değerleri değiştirin:  cp .env.example .env
# .env dosyası .gitignore içindedir; asla commit etmeyin.

# --- PostgreSQL ---
POSTGRES_DB=zimmet
POSTGRES_USER=zimmet
POSTGRES_PASSWORD=degistir-bunu-guclu-bir-parola

# --- API ---
# En az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=degistir-bunu-en-az-32-karakterlik-rastgele-bir-deger
JWT_EXPIRES_IN=8h

# QR kodların içine yazılacak adres (uygulamaya tarayıcıdan erişilen adres)
APP_BASE_URL=http://localhost:8080

# İlk yönetici hesabı (veritabanında hiç admin yoksa oluşturulur)
SEED_ADMIN_EMAIL=admin@kurum.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_NAME=Sistem Yöneticisi

# Örnek departman/personel/cihaz verisi yüklensin mi? (true/false)
SEED_DEMO_DATA=true

# Uygulamanın tarayıcıdan açılacağı port
WEB_PORT=8080
